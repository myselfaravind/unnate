# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN

# Demo builds hold placeholder content: keep them out of search results.
/demos/*
  X-Robots-Tag: noindex

# Fonts are cached for a year. Media is cached for a week, because a replaced image keeps its file name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/work/*
  Cache-Control: public, max-age=604800
/assets/img/*
  Cache-Control: public, max-age=604800
